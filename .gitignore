# Secrets — the relay generates its HMAC secret at first run.
# This must never be committed; the firmware bakes it in at build time.
shepherd.secret
*.secret
secrets/
.env
.env.*

# Python (relay/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# PlatformIO (firmware/)
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/

# Build output / firmware images
*.bin
*.elf
*.map

# Local audit log — contains full prompt text from work repos
shepherd-audit.log
*.audit.log

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Probe artefacts (plugin environment captures)
.probe3-env.jsonl
plugin/.probe3-env.jsonl

# Relay state when run outside Herdr (normally HERDR_PLUGIN_STATE_DIR)
plugin/.state/

# The firmware build flag holding the shared HMAC secret
firmware/secret.ini
